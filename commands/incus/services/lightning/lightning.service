# NVIDIA Nemotron 3.5 Lightning 30B-A3B — llama.cpp Vulkan 서버 (ai 컨테이너)
#
# /etc/systemd/system/lightning.service 로 배포한다. 배포는 deploy.sh 가 한다.
#
# Glimmer 와 VRAM(24GB)을 나눠 가질 수 없으므로 상호 배타다:
# Conflicts= 로 한쪽을 켜면 다른 쪽이 내려간다. 포트는 8082 로 분리해
# 프로바이더 등록이 서로 섞이지 않게 한다.
#
# 아키텍처가 nemotron_h_moe(Mamba-2 하이브리드 MoE, 활성 3B)라 Glimmer 와
# 파라미터 상식이 다르다 — KV 양자화 플래그는 하이브리드 캐시와의 상호작용이
# 미검증이라 넣지 않는다. MTP 드래프터(mtp-*.gguf)는 받아뒀지만 llama.cpp 의
# MTP 지원이 아직 미성숙해 1차 구성에서는 쓰지 않는다.

[Unit]
Description=Nemotron 3.5 Lightning llama.cpp server
After=network-online.target
Wants=network-online.target
Conflicts=glimmer.service
# GPU 가 죽으면 llama-server 는 영원히 못 뜬다 — 재시작은 회복이 아니라 은폐가 된다.
# 실측 2026-08-20: dGPU 하드 행 뒤 glimmer 가 72회를 돌았고, 유닛은 내내
# activating 으로 보여 로딩 중과 구분되지 않았다. 5회에서 failed 로 확정한다.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  -m /mnt/data/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_0.gguf \
  --alias nemotron-lightning \
  --host 10.10.10.14 --port 8082 \
  -dev Vulkan0 \
  -ngl 99 \
  -c 65536 \
  --jinja \
  --no-warmup
Restart=on-failure
RestartSec=10
# 17.6GB 모델을 VRAM 에 올리는 데 시간이 걸린다
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
