# Forgejo — Git 저장소 + Actions (core 컨테이너의 Quadlet 정의)
#
# /etc/containers/systemd/forgejo.container 로 배포하면 systemd 생성기가
# forgejo.service 를 만든다. 배포는 deploy.sh 가 한다.
#
# 웹 설치 마법사는 쓰지 않는다. FORGEJO__* 환경변수가 설정을 주입하고
# INSTALL_LOCK 이 마법사를 잠근다. 관리자 계정은 deploy.sh 가 CLI로 만든다.

[Unit]
Description=Forgejo Git service
After=network-online.target
Wants=network-online.target

[Container]
Image=codeberg.org/forgejo/forgejo:16
ContainerName=forgejo
Volume=/mnt/data/forgejo:/data
Volume=/etc/localtime:/etc/localtime:ro
# HTTP 웹 UI / API — 호스트의 tailscale serve 가 같은 번호의 HTTPS 포트로 프록시한다:
#   tailscale serve --https=3000 --bg http://10.10.10.11:3000
# (설정은 tailscaled 상태에 저장돼 재부팅 후에도 유지된다.
#  서비스마다 컨테이너 포트 번호를 그대로 tailnet 도메인에 노출하는 규약이다)
PublishPort=3000:3000
# Git SSH — core 자체 sshd 가 22 를 쓰므로 2222 로 내보낸다
PublishPort=2222:22
Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=FORGEJO__database__DB_TYPE=sqlite3
Environment=FORGEJO__server__DOMAIN=gem12.tail4555a7.ts.net
Environment=FORGEJO__server__ROOT_URL=https://gem12.tail4555a7.ts.net:3000/
Environment=FORGEJO__server__SSH_DOMAIN=10.10.10.11
Environment=FORGEJO__server__SSH_PORT=2222
Environment=FORGEJO__security__INSTALL_LOCK=true
Environment=FORGEJO__service__DISABLE_REGISTRATION=true

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
