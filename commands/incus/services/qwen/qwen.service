# Qwen 3.8-27B — llama.cpp Vulkan 서버 (ai 컨테이너)
#
# /etc/systemd/system/qwen.service 로 배포한다. 배포는 deploy.sh 가 한다.
#
# Glimmer·Lightning 과 VRAM(24GB)을 나눠 가질 수 없으므로 상호 배타다:
# Conflicts= 는 양방향이라 어느 쪽을 켜도 나머지가 내려간다. 포트는 8083 으로
# 분리해 프로바이더 등록이 서로 섞이지 않게 한다.
#
# 아키텍처는 qwen35(64층 중 16층만 전역 어텐션, 48층은 Gated DeltaNet). 서버
# 빌드(60eeeb6, 2026-08-17)에 Vulkan gated_delta_net 셰이더와 qwen35 등록이
# 들어 있어 재빌드 없이 뜬다. 같은 아키텍처 계열이 7900 XTX Vulkan 에서 출력이
# 깨진 이력(llama.cpp #20651)이 있으므로 첫 기동 뒤 짧은 프롬프트로 일관성을
# 반드시 확인한다 — 모델은 정상 속도로 쓰레기를 내놓을 수 있다.
#
# 1차 구성은 보수적이다:
#   -c 65536        Q4_K_M 가중치가 17.7GiB 라 Glimmer(15.6GiB)보다 VRAM 여유가
#                   좁다. 어텐션 16층만 KV 를 쓰니 컨텍스트 자체는 싸지만, 08-20
#                   의 하드 행이 프롬프트 캐시 축출 중에 났으므로 실측 뒤 올린다.
#   KV 양자화 없음   하이브리드 캐시와 -ctk/-ctv 의 상호작용이 미검증(lightning 과
#                   같은 이유).
#   MTP 없음        출력 건전성을 먼저 확인한다. 통과하면 아래 두 줄을 ExecStart 에
#                   넣는다 (커뮤니티 실측 디코드 +33~39%):
#                     -md /mnt/data/models/mtp-Qwen3.8-27B-Q4_0.gguf \
#                     --spec-type draft-mtp \

[Unit]
Description=Qwen 3.8-27B llama.cpp server
After=network-online.target
Wants=network-online.target
Conflicts=glimmer.service lightning.service
# GPU 가 죽으면 llama-server 는 영원히 못 뜬다 — 재시작은 회복이 아니라 은폐가 된다.
# 실측 2026-08-20: dGPU 하드 행 뒤 glimmer 가 72회를 돌았고, 유닛은 내내
# activating 으로 보여 로딩 중과 구분되지 않았다. 5회에서 failed 로 확정한다.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  -m /mnt/data/models/Qwen3.8-27B-Q4_K_M.gguf \
  --alias qwen3.8 \
  --host 10.10.10.14 --port 8083 \
  -dev Vulkan0 \
  --metrics \
  -ngl 99 \
  -c 65536 \
  -fa on \
  --jinja \
  --no-warmup
Restart=on-failure
RestartSec=10
# 17.7GiB 모델을 VRAM 에 올리는 데 시간이 걸린다
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
