      "parameters": {
        "jsCode": "\n// 화자·시각 메타를 붙여 프롬프트 조립\nconst src = $('Normalize').first().json;\nconst NAMES = { '983731763182469191': '관리자' };\nconst now = new Date().toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' });\nconst speaker = NAMES[src.author_id] ?? '미등록';\nreturn [{ json: {\n  ...src,\n  prompt: `[현재 시각: ${now} KST] [화자: ${speaker}]\\n${src.content}`,\n} }];\n"
      },
