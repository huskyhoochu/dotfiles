    {
      "parameters": {
        "jsCode": "\nconst HELP = [\n  '**GEM12 개발 제어 봇**',\n  '',\n  '`/issue 저장소 제목` — 이슈 발급 (implement 라벨 없음)',\n  '`/implement 저장소 번호` — implement 라벨 부착 (루프 자동 투입은 준비 중)',\n  '`/issues 저장소` — 열린 이슈 목록',\n  '`/pr 저장소` — 열린 PR 목록',\n  '`/status 실행ID` · `/runs` · `/cancel 실행ID` — 준비 중',\n  '',\n  '채널에 그냥 말하면 챗봇이 답한다(멘션 불필요). 과제가 구체화되면 /issue 로 발급.',\n].join('\\n');\n\nfor (const item of $input.all()) {\n  const c = item.json.command;\n  item.json._app = item.json.application_id;\n  item.json._tok = item.json.interaction_token;\n  if (!c) { item.json._reply = HELP; continue; }\n  const parts = String(item.json.content || '').split('\\n').filter(Boolean);\n  switch (c) {\n    case 'help':\n      item.json._reply = HELP;\n      break;\n    case 'issue':\n      if (!parts[0] || !parts[1]) { item.json._reply = '사용법: `/issue owner/repo 제목`'; break; }\n      item.json._repo = parts[0];\n      item.json._title = parts.slice(1).join(' ');\n      item.json._action = 'create_issue';\n      break;\n    case 'implement': {\n      const n = parseInt(parts[1], 10);\n      if (!parts[0] || !Number.isFinite(n)) {\n        item.json._reply = '사용법: `/implement owner/repo 이슈번호`';\n      } else {\n        item.json._repo = parts[0];\n        item.json._issue_number = n;\n        item.json._action = 'label_implement';\n      }\n      break;\n    }\n    case 'issues':\n    case 'pr':\n      if (!parts[0]) {\n        item.json._reply = `사용법: \\`/${c} owner/repo\\``;\n      } else {\n        item.json._repo = parts[0];\n        item.json._action = c === 'issues' ? 'list_issues' : 'list_prs';\n      }\n      break;\n    default:\n      item.json._reply = `\\`${c}\\` 커맨드는 아직 준비 중입니다.`;\n  }\n}\nreturn $input.all();\n"
      },
