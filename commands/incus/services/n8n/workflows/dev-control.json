    {
      "parameters": {
        "jsCode": "\n// 커맨드 분기별 최종 답장 문구를 만든다 (cross-node 참조를 여기서 한 번에 해결)\nconst cmd = $('Parse Command').first().json;\nconst errMsg = (e) => `Forgejo 요청 실패: ${String(e.message || e).split('\\n')[0].slice(0, 300)}`;\nlet reply;\nif (cmd._reply) {\n  reply = cmd._reply;\n} else {\n  const src = $input.first().json;\n  if (src && src._reply) {\n    reply = src._reply;\n  } else if (src && src.error) {\n    reply = errMsg(src.error);\n  } else {\n  const data = Array.isArray(src) ? src[0] : src;\n  switch (cmd._action) {\n    case 'create_issue':\n      reply = data && data.number\n        ? `이슈 발급: #${data.number} ${data.title}\\n${data.html_url}`\n        : '이슈 생성에 실패했거나 응답을 파싱하지 못했습니다.';\n      break;\n    case 'label_implement':\n      reply = data\n        ? 'implement 라벨 부착 완료. (에이전트 루프 자동 투입은 아직 연결되지 않음)'\n        : '라벨 부착 결과를 확인할 수 없습니다.';\n      break;\n    default:\n      reply = '완료되었습니다.';\n  }\n  }\n}\nreturn [{ json: { _reply: reply, _app: cmd._app, _tok: cmd._tok } }];\n"
      },
