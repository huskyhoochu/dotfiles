# Muse Glimmer 30B — llama.cpp Vulkan 서버 (ai 컨테이너)
#
# /etc/systemd/system/glimmer.service 로 배포한다. 배포는 deploy.sh 가 한다.
#
# 파라미터는 데스크톱 실측(run-muse-glimmer-server.sh 주석)을 그대로 옮긴 것이고,
# 바인드 주소만 사설망으로 바꿨다 — ci 컨테이너가 호출하기 때문이다.
#
# 서버 실측 (2026-08-18, 컨테이너 안):
#   VRAM 19171 / 24560 MiB (여유 5389 MiB — ComfyUI 로컬 노드 몫)
#   생성 29.0 tok/s (자유 서술) / 43.2 tok/s (정형 출력)
#   DFlash 채택률 13.6% / 24.4% — 정형 출력일수록 오른다
#
# -np(슬롯 수)는 일부러 지정하지 않는다. 기본값 -1(auto)에서 llama.cpp 가 4 를
# 고르고 kv_unified=true 로 슬롯들이 공용 KV 풀을 쓴다 — 슬롯이 4개여도 요청
# 하나가 -c 전량을 쓸 수 있다.
#
# `-np 2` 를 시험해 보고 되돌렸다 (2026-08-20 실측): 명시하는 순간 llama.cpp 가
# kv_unified=false 로 전환해 -c 를 슬롯 수로 나눈다. n_ctx_slot 이 98304→49152 로
# 반토막 나는데 VRAM 이득은 197 MiB(여유 5641→5838)뿐이라 값이 맞지 않았다.
# VRAM 압박은 -c 자체를 줄여서 잡는다.

[Unit]
Description=Muse Glimmer 30B llama.cpp server
After=network-online.target
Wants=network-online.target
# GPU 가 죽으면 llama-server 는 영원히 못 뜬다 — 재시작은 회복이 아니라 은폐가 된다.
# 실측 2026-08-20: dGPU 하드 행 뒤 72회를 돌았고, 유닛은 내내 activating 으로 보여
# 로딩 중과 구분되지 않았다. 5회에서 failed 로 확정해 점검과 대시보드에 드러낸다.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  -m /mnt/data/models/Muse-Glimmer-30B-KQuant-17GB-Q4_K_M.gguf \
  --alias muse-glimmer \
  --host 10.10.10.14 --port 8081 \
  -dev Vulkan0 \
  --metrics \
  -ngl 99 \
  -c 98304 \
  -fa on -ctk q8_0 -ctv q8_0 \
  -md /mnt/data/models/dflash-Muse-Glimmer-30B-Q4_K_M.gguf \
  --spec-type draft-dflash --spec-draft-n-max 15 \
  --jinja \
  --no-warmup
Restart=on-failure
RestartSec=10
# 17GB 모델을 VRAM 에 올리는 데 시간이 걸린다
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
