# /etc/gem12-healthcheck.env — deploy.sh 가 없을 때만 복사한다 (600)
#
# KUMA_PUSH_URL_<그룹>: Uptime Kuma 웹 UI 에서 Push 모니터를 만들면 나오는 URL.
#   점검이 7개 그룹으로 나뉘어 있고 그룹마다 모니터가 하나씩 붙는다.
#   모니터 설정 — 하트비트 주기 300초, 재시도 2 (uptime-kuma/deploy.sh 의 안내 참조)
#
#     gem12-host    디스크·RAM·btrfs·SMART·온도·기본 라우트
#     gem12-backup  backup.service 결과·타이머·GitHub 미러 push
#     gem12-core    Forgejo, core 컨테이너
#     gem12-apps    Litestream·n8n·NocoDB, apps 컨테이너
#     gem12-ci      Forgejo Runner, ci 컨테이너
#     gem12-ai      llama.cpp(glimmer|lightning)·ComfyUI, ai 컨테이너
#     gem12-media   Immich·Jellyfin, media 컨테이너
#
#   나눈 이유는 실측이다 (2026-08-20): 단일 모니터로 집계하면 먼저 난 장애가
#   뒤에 난 장애를 가려 이력에 남지 않는다. 상세는 healthcheck.sh 헤더 참조.
#
# 비어 있는 그룹은 push 없이 journal 기록만 한다 — 나머지 그룹은 정상 동작한다.
#
# FORGEJO_TOKEN: GitHub 미러 push 감시용 Forgejo API 토큰 (read:repository).
#   deploy.sh 가 비어 있으면 CLI 로 발급해 기입한다. 비어 있으면 점검이
#   mirror-token-missing 으로 실패한다 (backup 그룹).

KUMA_PUSH_URL_HOST=
KUMA_PUSH_URL_BACKUP=
KUMA_PUSH_URL_CORE=
KUMA_PUSH_URL_APPS=
KUMA_PUSH_URL_CI=
KUMA_PUSH_URL_AI=
KUMA_PUSH_URL_MEDIA=
FORGEJO_TOKEN=
