# 5분마다 상태 점검 1회 실행 — healthcheck.timer 가 부른다 (호스트 /etc/systemd/system/)
# 스크립트는 deploy.sh 가 /usr/local/sbin/gem12-healthcheck 로 설치한다 —
# /root/dotfiles 직접 실행은 SELinux(admin_home_t)가 막는다(실측, backup 과 동일).

[Unit]
Description=Host health checks pushed to Uptime Kuma

[Service]
Type=oneshot
# systemd 는 시스템 서비스에 HOME 을 주지 않는다 — incus CLI 가
# HOME 아래 설정 경로를 요구한다 (backup.service 와 같은 함정).
Environment=HOME=/root
ExecStart=/usr/local/sbin/gem12-healthcheck
TimeoutStartSec=120
