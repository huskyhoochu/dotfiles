# /etc/comfyui.env — ai 컨테이너 안, root:root 600
#
# LLM_KEY  op://Personal/OPENROUTER_API_KEY — ComfyUI-Openrouter_node 가 읽는
#   변수명이 LLM_KEY 다 (agent-loop 과 같은 OpenRouter 키를 재사용한다).
# ZENMUX_API_KEY  op://Personal/ZENMUX_API_KEY — ZenMux 비디오 노드용
#   (참조 이미지 data URI 첨부 + 5xx 보상. pi 와 같은 키 재사용).

# R2_*  op://Personal/GEM12_R2 의 필드들 — 참조 이미지 공개 URL 호스팅
#   (Seedance 2.5/Kling 의 URL 전용 참조 경로. R2ImageURL 노드가 사용.
#    비어 있으면 해당 노드만 실패하고 나머지는 무관)

LLM_KEY=
ZENMUX_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
