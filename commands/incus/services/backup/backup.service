# 매시 백업 1회 실행 — backup.timer 가 부른다 (호스트 /etc/systemd/system/)
# 스크립트는 deploy.sh 가 /usr/local/sbin/gem12-backup 으로 설치한다 —
# /root/dotfiles 직접 실행은 SELinux(admin_home_t)가 막는다(실측).
#
# TimeoutStartSec: 초기 풀백업이나 Wi-Fi 저속 구간을 견딘다.

[Unit]
Description=btrfs snapshot + restic backup to Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gem12-backup
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
