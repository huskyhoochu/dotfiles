# 주 1회 restic 저장소 정리 — backup-prune.timer 가 부른다 (호스트 /etc/systemd/system/)
#
# prune: forget 이 태그만 지운 데이터를 실제로 회수한다. Drive 왕복이 많아
#        매시 돌리지 않고 주 1회로 모은다.
# check --read-data-subset=5%: 매주 5% 씩 실데이터를 내려받아 검증한다.
#        디스크 1개짜리 서버라 백업 자체의 부패를 조기에 알아채야 한다 (§8).

[Unit]
Description=Weekly restic prune + integrity check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=RESTIC_REPOSITORY=rclone:gdrive:gem12-backup
Environment=RESTIC_PASSWORD_FILE=/root/.restic-password
ExecStart=/usr/bin/restic prune --limit-upload 4096 -o rclone.connections=4 --quiet
ExecStart=/usr/bin/restic check --limit-download 4096 -o rclone.connections=4 --read-data-subset=5%%
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
