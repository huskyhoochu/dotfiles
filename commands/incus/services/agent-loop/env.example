# /etc/agent-loop.env — ci 컨테이너 안, root:root 600
#
# 에이전트 루프가 쓰는 시크릿 목록. 값은 1Password 에 있다 (원칙 5:
# 시크릿은 git 에 넣지 않되 목록은 git 에 남긴다).
#
# FORGEJO_TOKEN       op://Personal/GEM12_FORGEJO_TOKEN — clone/push/tea 공용
# OPENROUTER_API_KEY  op://Personal/OPENROUTER_API_KEY  — 클라우드 모델 호출 시

FORGEJO_TOKEN=
OPENROUTER_API_KEY=
