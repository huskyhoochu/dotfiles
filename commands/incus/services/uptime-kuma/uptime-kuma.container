# Uptime Kuma — 모니터링 대시보드 + 알림 (core 컨테이너의 Quadlet 정의)
#
# /etc/containers/systemd/uptime-kuma.container 로 배포하면 systemd 생성기가
# uptime-kuma.service 를 만든다. 배포는 deploy.sh 가 한다.
#
# 역할 분담 (계획 §1-3): 실제 점검은 호스트의 gem12-healthcheck 타이머가 하고,
# Kuma 는 push 모니터로 그 결과를 받아 상태 이력과 알림을 맡는다. 하트비트가
# 끊기면(호스트 점검 스크립트가 죽어도) down 으로 처리된다.
#
# 데이터는 /mnt/data/uptime-kuma — 호스트 /mnt/data/core/uptime-kuma 이므로
# 매시 restic 백업에 자동으로 포함된다. 관리자 계정과 push 토큰은 첫 접속 때
# 웹 UI 에서 만든다 (deploy.sh 안내 참조).

[Unit]
Description=Uptime Kuma monitoring
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/louislam/uptime-kuma:2
ContainerName=uptime-kuma
Volume=/mnt/data/uptime-kuma:/app/data
Volume=/etc/localtime:/etc/localtime:ro
# 호스트의 tailscale serve 가 같은 번호의 HTTPS 포트로 프록시한다 (규약):
#   https://gem12.tail4555a7.ts.net:3001
PublishPort=3001:3001

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
